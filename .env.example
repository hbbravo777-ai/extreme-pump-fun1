SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_CLUSTER=devnet
PROGRAM_ID=
# Basis points: 10,000 bps = 100%. Platform fee is fixed at 100 bps (1%).
PLATFORM_FEE_BPS=100
# Example creator rate only; finalize before production.
CREATOR_FEE_BPS=100
RAYDIUM_MIGRATION_ENABLED=false
RAYDIUM_OWNER_PUBLIC_KEY=

# Raydium CPMM devnet script (never put secret key material in this file)
KEYPAIR_PATH=~/.config/solana/id.json
TOKEN_MINT=
TOKEN_AMOUNT_BASE_UNITS=
SOL_AMOUNT_LAMPORTS=
CPMM_FEE_CONFIG_INDEX=0
ALLOW_RAYDIUM_POOL_CREATION=NO

# Web app public configuration (never place secrets in VITE_ variables)
VITE_SOLANA_CLUSTER=devnet
VITE_RPC_URL=https://api.devnet.solana.com
VITE_PROGRAM_ID=
