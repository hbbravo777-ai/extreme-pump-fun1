{
  "name": "extreme-pump-fun",
  "version": "0.1.0",
  "private": true,
  "description": "Extreme Pump.Fun Solana token launchpad core",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/**/*.test.js",
    "typecheck": "tsc --noEmit",
    "raydium:devnet": "tsx scripts/raydium/create-cpmm-pool.ts",
    "web:dev": "vite --config web/vite.config.ts",
    "web:build": "vite build --config web/vite.config.ts",
    "dev": "npm run web:dev"
  },
  "dependencies": {
    "@raydium-io/raydium-sdk-v2": "^0.2.40",
    "@solana/web3.js": "^1.98.4",
    "@solana/wallet-adapter-base": "^0.9.27",
    "@solana/wallet-adapter-react": "^0.15.35",
    "@solana/wallet-adapter-react-ui": "^0.9.35",
    "@solana/wallet-adapter-wallets": "^0.19.36",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "typescript": "^5.8.3",
    "tsx": "^4.19.3",
    "bn.js": "^5.2.2",
    "@types/bn.js": "^5.1.6",
    "dotenv": "^16.5.0",
    "@types/react": "^18.3.20",
    "@types/react-dom": "^18.3.6",
    "@vitejs/plugin-react": "^4.4.1",
    "vite": "^6.3.5"
  },
  "engines": {
    "node": ">=20"
  }
}
